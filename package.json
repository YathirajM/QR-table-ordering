{
  "name": "restaurant-qr-ordering-platform",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrate restaurant-db",
    "db:seed": "wrangler d1 execute restaurant-db --local",
    "generate:db-types": "wrangler d1 generate restaurant-db"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "lucide-react": "^0.445.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "zod": "^3.24.0",
    "framer-motion": "^11.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "react-router-dom": "^6.26.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "@vitejs/plugin-react": "^5.2.0"
  },
  "wrangler": {
    "name": "restaurant-qr-ordering",
    "account_id": "",
    "workers_dev": true,
    "route": null,
    "zone_id": null,
    "kv_namespaces": [],
    "d1_databases": [
      {
        "binding": "DB",
        "id": null,
        "preview_id": null,
        "plugin_name": "restaurant-db"
      }
    ],
    "r2_buckets": [
      {
        "binding": "R2_BUCKET",
        "name": "restaurant-images"
      }
    ],
    "compatibility_date": "2024-01-01",
    "compatibility_flags": [],
    "build": {
      "command": "npm run build",
      "dump_dir": null
    },
    "tailwindcss": true,
    "ipynb_assets": true,
    "templates": []
  }
}